---
const { title = 'David Feng' } = Astro.props;
const base = import.meta.env.BASE_URL;
const favicon = `${base}${base.endsWith('/') ? '' : '/'}favicon.ico`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href={favicon} />
    <title>{title}</title>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/3.7.2/animate.min.css"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Sintony:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <link href="https://fonts.googleapis.com/css?family=Pridi|Sintony&display=swap" rel="stylesheet" />
    <script is:inline src="https://kit.fontawesome.com/7178d801fb.js" crossorigin="anonymous"
    ></script>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  body {
    background-size: cover;
    background-color: #edeff2;
    margin: 0;
    padding: 0;
  }
</style>
