---
interface Slide {
  src: string;
  alt: string;
  caption: string;
}

const { slides } = Astro.props as { slides: Slide[] };
---

<div
  class="carousel"
  data-carousel
  tabindex="0"
  role="region"
  aria-roledescription="carousel"
  aria-label="Travel photos"
>
  <div class="viewport" data-viewport>
    <div class="track" data-track>
      {
        slides.map((slide, index) => (
          <figure class="slide" data-slide aria-hidden={index === 0 ? 'false' : 'true'}>
            <img src={slide.src} alt={slide.alt} width="1248" height="832" />
            <figcaption>{slide.caption}</figcaption>
          </figure>
        ))
      }
    </div>
  </div>
  <button class="nav prev" type="button" data-prev aria-label="Previous photo">
    <span aria-hidden="true">‹</span>
  </button>
  <button class="nav next" type="button" data-next aria-label="Next photo">
    <span aria-hidden="true">›</span>
  </button>
  <div class="dots" role="tablist" aria-label="Choose a photo">
    {
      slides.map((slide, index) => (
        <button
          class="dot"
          type="button"
          role="tab"
          data-dot={index}
          aria-label={slide.caption}
          aria-selected={index === 0 ? 'true' : 'false'}
        />
      ))
    }
  </div>
</div>

<script>
  function startCarousel(root: HTMLElement) {
    const track = root.querySelector<HTMLElement>('[data-track]');
    const viewport = root.querySelector<HTMLElement>('[data-viewport]');
    const slideEls = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-next]');
    if (!track || !viewport || slideEls.length === 0 || !prev || !next) return;

    let index = 0;

    const show = (nextIndex: number) => {
      index = (nextIndex + slideEls.length) % slideEls.length;
      track.style.transform = `translateX(-${index * 100}%)`;
      slideEls.forEach((slide, i) => {
        slide.classList.remove('is-revealed');
        slide.setAttribute('aria-hidden', String(i !== index));
      });
      dots.forEach((dot, i) => {
        dot.setAttribute('aria-selected', String(i === index));
      });
    };

    prev.addEventListener('click', () => show(index - 1));
    next.addEventListener('click', () => show(index + 1));
    dots.forEach((dot) => {
      dot.addEventListener('click', () => show(Number(dot.dataset.dot)));
    });

    root.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        show(index - 1);
      }
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        show(index + 1);
      }
    });

    let startX = 0;
    let tracking = false;
    viewport.addEventListener('pointerdown', (event) => {
      if (event.pointerType === 'mouse' && event.button !== 0) return;
      tracking = true;
      startX = event.clientX;
    });
    viewport.addEventListener('pointerup', (event) => {
      if (!tracking) return;
      tracking = false;
      const delta = event.clientX - startX;
      if (delta > 48) show(index - 1);
      else if (delta < -48) show(index + 1);
      else if (event.pointerType !== 'mouse') slideEls[index].classList.toggle('is-revealed');
    });
    viewport.addEventListener('pointercancel', () => {
      tracking = false;
    });

    show(0);
  }

  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach(startCarousel);
</script>

<style>
  .carousel {
    position: relative;
    outline: none;
  }

  .carousel:focus-visible {
    box-shadow: 0 0 0 3px #2364aa;
  }

  .viewport {
    overflow: hidden;
    border-radius: 16px;
    box-shadow: 0 0 3px 1px rgba(0, 0, 0, 0.3);
    background: #101010;
    touch-action: pan-y;
  }

  .track {
    display: flex;
    transition: transform 0.45s ease;
  }

  .slide {
    position: relative;
    flex: 0 0 100%;
    margin: 0;
  }

  .slide img {
    display: block;
    width: 100%;
    height: min(62vw, 460px);
    object-fit: cover;
  }

  figcaption {
    position: absolute;
    z-index: 2;
    left: 0;
    right: 0;
    bottom: 0;
    margin: 0;
    padding: 48px 22px 18px;
    background: linear-gradient(transparent, rgba(16, 16, 16, 0.72) 46%);
    color: #f4f5f7;
    font-family: 'Sintony', sans-serif;
    font-size: 15px;
    font-weight: 400;
    letter-spacing: 0.01em;
    opacity: 0;
    transform: translateY(4px);
    pointer-events: none;
    transition:
      opacity 0.35s ease,
      transform 0.35s ease;
  }

  .viewport:hover .slide[aria-hidden='false'] figcaption,
  .slide.is-revealed figcaption,
  .carousel:focus-visible .slide[aria-hidden='false'] figcaption {
    opacity: 1;
    transform: none;
  }

  .nav {
    position: absolute;
    top: calc(min(62vw, 460px) / 2);
    transform: translateY(-50%);
    width: 42px;
    height: 42px;
    border: 0;
    border-radius: 50%;
    background: rgba(237, 239, 242, 0.92);
    color: #191721;
    font-size: 28px;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 0 3px 1px rgba(0, 0, 0, 0.3);
  }

  .nav:hover,
  .nav:focus-visible {
    background: #fec601;
  }

  .prev {
    left: 12px;
  }

  .next {
    right: 12px;
  }

  .dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 14px;
  }

  .dot {
    width: 10px;
    height: 10px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: #c5c8ce;
    cursor: pointer;
  }

  .dot[aria-selected='true'] {
    background: #2364aa;
  }

  @media (prefers-reduced-motion: reduce) {
    .track,
    figcaption {
      transition: none;
    }
  }
</style>
