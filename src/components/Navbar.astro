---
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const links = [
  { href: base, label: 'Home' },
  { href: `${base}nyc/`, label: 'NYC' },
  { href: `${base}ski-trip/`, label: 'Swiss Ski Trip' },
];
---

<nav class="site-nav" aria-label="Main">
  <a class="brand" href={base}>DF</a>
  <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Toggle menu" />
  <label for="nav-toggle" class="nav-burger" aria-hidden="true"><span></span></label>
  <ul>
    {links.map((l) => (
      <li><a href={l.href}>{l.label}</a></li>
    ))}
  </ul>
</nav>

<style>
  .site-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 32px;
    background: rgba(255, 255, 255, 0.72);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 1px 6px rgba(0, 0, 0, 0.08);
    font-family: 'Sintony', sans-serif;
  }
  .brand {
    font-weight: 700;
    font-size: 1.3em;
    color: #191721;
    text-decoration: none;
    letter-spacing: 0.06em;
  }
  ul {
    list-style: none;
    display: flex;
    gap: 6px;
    margin: 0;
    padding: 0;
  }
  ul a {
    display: block;
    padding: 6px 14px;
    border-radius: 999px;
    color: #191721;
    text-decoration: none;
    font-size: 0.95em;
    transition: background 0.2s;
  }
  ul a:hover {
    background: rgba(25, 23, 33, 0.08);
  }
  .nav-toggle,
  .nav-burger {
    display: none;
  }
  @media (max-width: 700px) {
    .nav-burger {
      display: block;
      width: 28px;
      height: 20px;
      position: relative;
      cursor: pointer;
    }
    .nav-burger span,
    .nav-burger span::before,
    .nav-burger span::after {
      content: '';
      position: absolute;
      left: 0;
      width: 28px;
      height: 3px;
      background: #191721;
      border-radius: 2px;
    }
    .nav-burger span { top: 8px; }
    .nav-burger span::before { top: -8px; }
    .nav-burger span::after { top: 8px; }
    ul {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      background: rgba(255, 255, 255, 0.96);
      padding: 8px 16px 14px;
    }
    .nav-toggle:checked ~ ul {
      display: flex;
    }
  }
</style>
